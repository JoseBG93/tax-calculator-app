# ==============================================================================
# Tax Calculator Pro - Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Replace placeholder values with your actual configuration
# 3. NEVER commit the .env file to version control
#
# Generate SECRET_KEY: python scripts/secrets_generator.py
#

# ==============================================================================
# Flask Core Configuration
# ==============================================================================

# REQUIRED: Cryptographic secret key for session management and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-replace-with-generated-64-char-hex-string

# Flask environment: development, testing, production
FLASK_ENV=development

# Flask application entry point
FLASK_APP=run.py

# Debug mode (set to False in production!)
FLASK_DEBUG=True

# ==============================================================================
# Database Configuration
# ==============================================================================

# SQLite (Development)
DATABASE_URL=sqlite:///database/taxcalculator.db

# PostgreSQL (Production example)
# DATABASE_URL=postgresql://user:password@localhost:5432/taxcalculator

# ==============================================================================
# CORS Configuration
# ==============================================================================

# Allowed origins for Cross-Origin Resource Sharing (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5001

# ==============================================================================
# Admin Configuration
# ==============================================================================

# Superadmin identification (recommended: use ID for stability)
SUPERADMIN_USER_ID=1
SUPERADMIN_USERNAME=admin

# ==============================================================================
# Security Headers
# ==============================================================================

SECURITY_HEADERS_ENABLED=True
SESSION_COOKIE_SECURE=False          # Set True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ==============================================================================
# Rate Limiting
# ==============================================================================

RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour

# ==============================================================================
# Application Configuration
# ==============================================================================

MUNICIPALITY_NAME=Alfafar
MUNICIPALITY_CODE=46009
MUNICIPALITY_TAX_RATE=29.0

# ==============================================================================
# Logging
# ==============================================================================

LOG_LEVEL=INFO
LOG_FILE=logs/taxcalculator.log
