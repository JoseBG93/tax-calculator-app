{
    "python.defaultInterpreterPath": "./taxapp/bin/python",
    "python.terminal.activateEnvironment": true,
    "editor.formatOnSave": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "claude.contextFiles": ["CLAUDE.md"],
    "claude.autoReadContext": true,
    "editor.tokenColorCustomizations": {
        "comments": "orange",
        "strings": "green",
        "keywords": "blue",
        "functions": "purple",
        "variables": "red",
        "numbers": "yellow",
        "booleans": "cyan",
        "null": "gray"
    }
}